{
  "info": {
    "_postman_id": "fit4110-lab03-team-vision",
    "name": "FIT4110 Lab03 - Team Vision Contract Tests",
    "description": "Postman collection for AI Vision provider-side contract tests, Camera consumer smoke tests, Newman evidence, and local-only non-functional checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const prefix = pm.environment.get('tracePrefix') || 'team-vision';",
          "const timestamp = Date.now();",
          "pm.variables.set('traceId', `${prefix}-trace-${timestamp}`);",
          "pm.variables.set('requestId', `REQ-CAM-${timestamp}`);",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.environment.get('correlationId') || `CORR-${timestamp}` });"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "00_Health",
      "item": [
        {
          "name": "GET /health - service is alive",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
